{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm:*)",
      "Bash(npx vite:*)",
      "Bash(npx vercel:*)",
      "Bash(npx netlify:*)",
      "Bash(npx surge:*)",
      "Bash(npx gh-pages:*)",
      "Bash(npx wrangler:*)",
      "Bash(node:*)",
      "Bash(pip install edge-tts)",
      "Bash(pip3 install edge-tts)",
      "Bash(edge-tts:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(cd:*)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.github/hooks/scripts/session-start.mjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.github/hooks/scripts/guard-command.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.github/hooks/scripts/validate-artifact.mjs"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.github/hooks/scripts/check-audio-output.mjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.github/hooks/scripts/verify-final.mjs"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
