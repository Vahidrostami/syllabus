{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/session-start.mjs",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/guard-command.mjs",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/validate-artifact.mjs",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "node .github/hooks/scripts/check-audio-output.mjs",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/verify-final.mjs",
        "timeout": 300
      }
    ]
  }
}
